# ============================================================================
# VeriDoc - environment configuration
# Copy to .env and adjust. Secrets belong here and nowhere else; nothing in this
# file is read by the browser bundle.
# ============================================================================

# --- application ------------------------------------------------------------
APP_ENV=development                 # development | staging | production | test
DEBUG=false
DEMO_MODE=true                      # surfaces demo-provider banners in the UI
API_PREFIX=/api

# --- database (Supabase-compatible PostgreSQL) ------------------------------
# Supabase: postgresql+psycopg://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://veridoc:veridoc@localhost:55432/veridoc
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- authentication ---------------------------------------------------------
# Generate with:  openssl rand -hex 48
JWT_SECRET=change-me-in-production-please-use-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=45
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_HASH_SCHEME=argon2
SIGNED_URL_TTL_SECONDS=300

# --- CORS / transport security ---------------------------------------------
ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
TRUSTED_HOSTS=*
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=40/minute

# --- uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=25
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tif,tiff
MAX_PAGE_COUNT=60
RENDER_DPI=150

# --- object storage ---------------------------------------------------------
# local: originals and artifacts under STORAGE_LOCAL_ROOT
# s3:    any S3-compatible endpoint (MinIO, AWS S3, Supabase Storage, R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./var/storage
S3_ENDPOINT_URL=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=veridoc
S3_SECRET_ACCESS_KEY=veridoc-secret
S3_BUCKET_ORIGINALS=veridoc-originals
S3_BUCKET_ARTIFACTS=veridoc-artifacts
S3_FORCE_PATH_STYLE=true
# S3_SERVER_SIDE_ENCRYPTION=AES256

# --- queue / workers --------------------------------------------------------
REDIS_URL=redis://localhost:63799/0
QUEUE_MODE=redis                    # redis | inline (inline needs no worker)
QUEUE_NAME=veridoc-analysis
ANALYSIS_TIMEOUT_SECONDS=600

# --- providers --------------------------------------------------------------
OCR_PROVIDER=hybrid                 # hybrid | tesseract | pdf_text | demo_fixture
OCR_LANGUAGE=eng

AIGC_PROVIDER=demo_heuristic        # demo_heuristic | remote_http
# AIGC_REMOTE_URL=https://vendor.example/v1/detect
# AIGC_REMOTE_API_KEY=
# Seconds to wait for the detector; covers a GPU cold start on a scale-to-zero host.
# AIGC_REMOTE_TIMEOUT=120

VERIFICATION_PROVIDER=demo          # demo | remote_http
# VERIFICATION_REMOTE_URL=https://insurer.example/verification
# VERIFICATION_REMOTE_API_KEY=

MALWARE_SCANNER=heuristic           # heuristic | clamav
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- privacy ----------------------------------------------------------------
RETENTION_DAYS=365
PII_LOG_REDACTION=true

# --- seeding ----------------------------------------------------------------
SEED_PASSWORD=Demo!2026

# --- frontend (Next.js) -----------------------------------------------------
# Server-side only: the browser never sees the API token.
BACKEND_API_URL=http://localhost:8088/api
SESSION_COOKIE_NAME=veridoc_session
NEXT_PUBLIC_APP_NAME=VeriDoc
NEXT_PUBLIC_DEMO_MODE=true
